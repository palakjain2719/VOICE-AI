# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Application
APP_BASE_URL=
CRON_SECRET=
# 32-byte key, base64 encoded: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# Shared secret the voice agent sends as `Authorization: Bearer <secret>` when calling /api/voice/tools/*
VOICE_TOOL_SECRET=

# Vaani Labs (keys start with vv_live_, webhook secrets with vv_whk_)
VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=
# Optional: published flow id/slug the agent should use
VAANI_FLOW_ID=

# Gemini (verify the current Flash model id at https://ai.google.dev/gemini-api/docs/models)
GEMINI_API_KEY=
GEMINI_MODEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://bkizxetbqmpzqtmfngkk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Postgres schema holding Aangan's tables (shares the project with other apps). Default: aangan
SUPABASE_DB_SCHEMA=
# Personal access token for migrations/scripts only (sbp_...). Do NOT add to Vercel.
SUPABASE_ACCESS_TOKEN=

# HubSpot (service key from Development > Keys > Service Keys)
HUBSPOT_SERVICE_KEY=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

# Studio access code for the Enter page (min 6 chars). Leave empty to use personal logins.
ACCESS_CODE=
